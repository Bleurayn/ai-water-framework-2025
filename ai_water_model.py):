# ============================================================
# SECTION 2: PHYSICS-BASED COOLING MODELS (No more lookups)
# ============================================================
def evaporation_reduction_factor(cooling_type, wet_bulb_C):
    """Evaporative vs dry vs hybrid cooling performance."""
    if cooling_type == 'evaporative':
        return 1.0  # baseline evaporation
    elif cooling_type == 'dry':
        # Dry cooling derates at high wet-bulb
        derate = max(0, min(1, (wet_bulb_C - 15) / 15))
        return 0.0 + derate * 0.3  # 0-30% evaporation penalty
    elif cooling_type == 'hybrid':
        # Dry + evaporative; evaporative fraction depends on wet-bulb
        evap_frac = max(0, min(1, (wet_bulb_C - 10) / 20))
        return evap_frac * 0.7  # 70% less evap when active
    elif cooling_type == 'immersion':
        return 0.05  # 95% evaporation reduction (practical limit)
    else:
        return 1.0

def energy_penalty_factor(cooling_type, cooling_load_MWh, wet_bulb_C):
    """Additional kWh per MWh of cooling (pumping, fans, chillers)."""
    if cooling_type == 'evaporative':
        return 50  # kWh/MWh (baseline, 0.05 COP)
    elif cooling_type == 'dry':
        # Higher fan power + lower efficiency at high wet-bulb
        penalty = 80 + (wet_bulb_C - 15) * 5 if wet_bulb_C > 15 else 80
        return max(50, min(200, penalty))
    elif cooling_type == 'hybrid':
        return 70  # intermediate
    elif cooling_type == 'immersion':
        # Pumping dielectric fluids + chillers
        return 120 + (wet_bulb_C - 20) * 10 if wet_bulb_C > 20 else 120
    else:
        return 50

# ============================================================
# SECTION 3: REALISTIC ADOPTION CURVES (Staged + Financial)
# ============================================================
def staged_adoption(years, tech, plant_budget, retrofit_rate_limit, capital_cost_per_MW):
    """
    Returns fraction of cooling load converted per year, capped by budget and rate.
    tech: 'immersion', 'dry', 'hybrid', 'nonpotable_shift'
    """
    n_years = len(years)
    adoption_frac = np.zeros(n_years)
    
    if tech == 'immersion':
        # S-curve potential (maximum 70% of load can go immersion)
        max_potential = 0.7
        midpoint = 2035
        steepness = 0.3
        unconstrained = max_potential / (1 + np.exp(-steepness * (years - midpoint)))
        
        # Capital cost ~$1000/kW = $1,000,000 per MW
        cost_per_MW = 1_000_000
        max_MW_per_year = plant_budget / cost_per_MW
        total_load_MW = plant_config['annual_cooling_load_mwh'] / (8760 * 0.7)  # rough avg MW
        
        # Apply constraints
        for i in range(1, n_years):
            increase = unconstrained[i] - unconstrained[i-1]
            max_increase = min(retrofit_rate_limit, max_MW_per_year / total_load_MW)
            actual_increase = min(increase, max_increase)
            adoption_frac[i] = adoption_frac[i-1] + actual_increase
            adoption_frac[i] = min(adoption_frac[i], max_potential)
    
    elif tech == 'nonpotable_shift':
        # Only applies to evaporative cooling systems
        max_potential = 0.8
        midpoint = 2040
        steepness = 0.25
        unconstrained = max_potential / (1 + np.exp(-steepness * (years - midpoint)))
        
        # No additional capital for non-potable if piping compatible
        adoption_frac = unconstrained if plant_config['existing_piping_compatible'] else unconstrained * 0.5
    
    elif tech == 'dry_cooling':
        # Space-limited
        max_potential = plant_config['space_for_dry_cooling_pct']
        midpoint = 2035
        steepness = 0.35
        unconstrained = max_potential / (1 + np.exp(-steepness * (years - midpoint)))
        adoption_frac = unconstrained
    
    return adoption_frac

# ============================================================
# SECTION 4: WATER QUALITY & DISCHARGE MODEL
# ============================================================
def water_quality_cost(source_type, treatment_needed):
    """Returns total $/kL including treatment and discharge."""
    base_cost = {
        'potable': plant_config['potable_water_cost_usd_per_kL'],
        'nonpotable': plant_config['nonpotable_water_cost_usd_per_kL'],
        'recycled': 0.50,
    }[source_type]
    
    treatment_cost = treatment_needed * plant_config['treatment_cost_usd_per_kL']
    
    # Blowdown disposal cost (cycles of concentration limit)
    if source_type == 'nonpotable':
        # Lower cycles of concentration → more blowdown
        blowdown_multiplier = 1.5
    else:
        blowdown_multiplier = 1.0
    
    disposal_cost = blowdown_multiplier * plant_config['blowdown_to_sewer_cost_usd_per_kL']
    
    return base_cost + treatment_cost + disposal_cost

# ============================================================
# SECTION 5: MAIN SIMULATION ENGINE (No omissions)
# ============================================================
def simulate_plant_water_savings(years, plant_config, monte_carlo_runs=500):
    n_years = len(years)
    
    # Pre-calc adoption curves
    immersion_frac = staged_adoption(years, 'immersion', 
                                     plant_config['capital_budget_usd_per_year'],
                                     plant_config['max_retrofit_rate_pct_per_year'],
                                     capital_cost_per_MW=1_000_000)
    nonpotable_frac = staged_adoption(years, 'nonpotable_shift', plant_config, 0, 0)
    dry_frac = staged_adoption(years, 'dry_cooling', plant_config, 0, 0)
    
    # Results storage
    all_results = []
    
    for run in range(monte_carlo_runs):
        # ----------------------------------------------------
        # Monte Carlo uncertainties (fat-tailed where relevant)
        # ----------------------------------------------------
        # AI growth: lognormal (fat tail)
        growth_early = np.random.lognormal(mean=np.log(1.25), sigma=0.15)  # ~25% ±15% (wide)
        growth_late = np.random.lognormal(mean=np.log(1.10), sigma=0.10)
        
        # Wet-bulb variability (climate year to year)
        wet_bulb_annual = plant_config['wet_bulb_C'] + np.random.normal(0, 2, n_years)
        wet_bulb_annual = np.clip(wet_bulb_annual, 10, 35)
        
        # Technology performance uncertainty (beta distribution, 0-1)
        immersion_evap_reduction = beta(a=8, b=2).rvs() * 0.3 + 0.65  # 65-95% reduction
        dry_cooling_effectiveness = beta(a=5, b=3).rvs()  # 0-1 effectiveness
        
        # Water price volatility (correlated across years)
        price_shock = np.random.normal(0, 0.2, n_years).cumsum() / 10  # random walk
        potable_price = plant_config['potable_water_cost_usd_per_kL'] * (1 + price_shock)
        potable_price = np.maximum(0.5, potable_price)
        
        # ----------------------------------------------------
        # Annual water & energy balance
        # ----------------------------------------------------
        annual_water_savings_L = np.zeros(n_years)
        annual_energy_penalty_kWh = np.zeros(n_years)
        annual_opex_change_usd = np.zeros(n_years)
        
        cooling_load_MWh = plant_config['annual_cooling_load_mwh']
        
        for i, year in enumerate(years):
            # Current water use without interventions
            base_water_L = cooling_load_MWh * plant_config['current_water_use_L_per_kwh'] * 1000
            
            # Fraction of load using each technology
            frac_immersion = immersion_frac[i]
            frac_dry = dry_frac[i] * (1 - frac_immersion)  # dry only on non-immersion load
            frac_evap_base = 1 - frac_immersion - frac_dry
            
            # Apply evap reduction per technology
            evap_factor = (frac_immersion * immersion_evap_reduction +
                          frac_dry * (1 - dry_cooling_effectiveness) * 0.2 +  # dry still has some evap
                          frac_evap_base * 1.0)
            
            # Water use after interventions
            new_water_L = base_water_L * evap_factor
            
            # Non-potable shift (only on remaining evaporative portion)
            nonpotable_eligible = base_water_L * (frac_evap_base + frac_dry * 0.5)
            nonpotable_actual = nonpotable_eligible * nonpotable_frac[i]
            potable_water_new = new_water_L - nonpotable_actual
            potable_water_new = max(0, potable_water_new)
            
            # Savings
            base_potable_L = base_water_L  # baseline is 100% potable
            water_saved_L = base_potable_L - potable_water_new
            annual_water_savings_L[i] = water_saved_L
            
            # Energy penalty
            energy_penalty_MWh = (frac_immersion * energy_penalty_factor('immersion', 1, wet_bulb_annual[i]) +
                                 frac_dry * energy_penalty_factor('dry', 1, wet_bulb_annual[i]) +
                                 frac_evap_base * energy_penalty_factor('evaporative', 1, wet_bulb_annual[i]))
            annual_energy_penalty_kWh[i] = cooling_load_MWh * energy_penalty_MWh * 1000
            
            # OPEX change (water saved cost - energy penalty - treatment)
            water_cost_saved = water_saved_L / 1000 * potable_price[i]
            energy_cost_added = annual_energy_penalty_kWh[i] * plant_config['electricity_cost_usd_per_kwh']
            treatment_cost = nonpotable_actual / 1000 * plant_config['treatment_cost_usd_per_kL']
            annual_opex_change_usd[i] = water_cost_saved - energy_cost_added - treatment_cost
        
        # Cumulative metrics
        cum_water_saved_L = np.cumsum(annual_water_savings_L)
        cum_opex_saved_usd = np.cumsum(annual_opex_change_usd)
        
        all_results.append({
            'run': run,
            'annual_savings_L': annual_water_savings_L,
            'cum_savings_L': cum_water_saved_L,
            'annual_opex_usd': annual_opex_change_usd,
            'cum_opex_usd': cum_opex_saved_usd,
            'immersion_frac': immersion_frac,
            'final_water_saved_L': cum_water_saved_L[-1],
            'final_opex_saved_usd': cum_opex_saved_usd[-1],
        })
    
    return years, all_results

# ============================================================
# SECTION 6: RUN SIMULATION & VISUALIZE
# ============================================================
